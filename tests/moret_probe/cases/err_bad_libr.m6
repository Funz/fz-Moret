MORET_BEGIN
ERREUR bibliotheque absente
* Hypothese : H29 LIBR inexistante : erreur lisible ou plantage
* Attendu    : ABNORMAL END, message bibliotheque

GEOM
  MODU 0
    TYPE 1 SPHE 8.7407
    VOLU 1 0 1 UMET 0. 0. 0.
  ENDM
ENDG

MATE
  CONT
    LIBR nolib999.xml
    TEMP 300
    COMP UMET
      CONC
        U234 4.91895E-04
        U235 4.49988E-02
        U238 2.49865E-03
    ENDC
  ENDM

SOUR
  UNIF 1000
ENDS

TERM
  CYCL PASS 30 ACTI 100
ENDT

ENDD
MORET_END
